   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "#--- Step 1: CSVファイル読み込み ---#\n",
    "df_sbma = pd.read_csv(\"0328_vol_42_sbma.csv\")\n",
    "df_control = pd.read_csv(\"0328_vol_42_control.csv\")\n",
    "\n",
    "#--- Step 2: 不要な列の削除 ---#\n",
    "drop_cols = [\"Entrez gene symbol\", \"group\", \"responder/non-responder\"]\n",
    "df_sbma = df_sbma.drop(columns=[col for col in drop_cols if col in df_sbma.columns])\n",
    "df_control = df_control.drop(columns=[col for col in drop_cols if col in df_control.columns])\n",
    "\n",
    "#--- Step 3: log2変換（ゼロ除けの微小値を加算） ---#\n",
    "df_sbma_log2 = np.log2(df_sbma + 1e-5)\n",
    "df_control_log2 = np.log2(df_control + 1e-5)\n",
    "\n",
    "#--- Step 4: 長形式に変換 ---#\n",
    "df1_long = df_sbma_log2.melt(var_name='Variable', value_name='Value')\n",
    "df1_long['Dataset'] = 'SBMA'\n",
    "\n",
    "df2_long = df_control_log2.melt(var_name='Variable', value_name='Value')\n",
    "df2_long['Dataset'] = 'Control'\n",
    "\n",
    "#--- Step 5: データ結合と数値変換 ---#\n",
    "combined_df = pd.concat([df1_long, df2_long])\n",
    "combined_df['Value'] = pd.to_numeric(combined_df['Value'], errors='coerce')\n",
    "\n",
    "#--- Step 6: p値が0.001未満のタンパク質リストを作成 ---#\n",
    "significant_vars = []\n",
    "for var in combined_df['Variable'].unique():\n",
    "    group1 = combined_df[(combined_df['Variable'] == var) & (combined_df['Dataset'] == 'SBMA')]['Value']\n",
    "    group2 = combined_df[(combined_df['Variable'] == var) & (combined_df['Dataset'] == 'Control')]['Value']\n",
    "    if len(group1) > 1 and len(group2) > 1:\n",
    "        _, p = ttest_ind(group1, group2, equal_var=False)\n",
    "        if p < 0.001:\n",
    "            significant_vars.append(var)\n",
    "\n",
    "#--- Step 7: タンパク質順＋スペース挿入 ---#\n",
    "variables = combined_df['Variable'].unique()\n",
    "spaced_variables = []\n",
    "for v in variables:\n",
    "    spaced_variables.append(v)\n",
    "    spaced_variables.append('')  # 空白ラベルを挿入\n",
    "\n",
    "#--- Step 8: 空白ダミー行（NaN）を追加 ---#\n",
    "dummy_rows = []\n",
    "for label in spaced_variables:\n",
    "    if label == '':\n",
    "        dummy_rows.append({'Variable': '', 'Value': np.nan, 'Dataset': 'SBMA'})\n",
    "        dummy_rows.append({'Variable': '', 'Value': np.nan, 'Dataset': 'Control'})\n",
    "combined_df_spaced = pd.concat([\n",
    "    combined_df,\n",
    "    pd.DataFrame(dummy_rows)\n",
    "])\n",
    "\n",
    "#--- Step 9: Boxplot描画 ---#\n",
    "plt.figure(figsize=(25, 7))\n",
    "ax = sns.boxplot(\n",
    "    x='Variable',\n",
    "    y='Value',\n",
    "    hue='Dataset',\n",
    "    data=combined_df_spaced,\n",
    "    hue_order=[\"Control\", \"SBMA\"],\n",
    "    palette={\"Control\": \"lightseagreen\", \"SBMA\": \"gold\"},\n",
    "    order=spaced_variables\n",
    ")\n",
    "\n",
  
