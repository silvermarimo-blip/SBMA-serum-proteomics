
import json
from pathlib import Path

src = Path("/mnt/data/boxplot_0328.ipynb")
dst = Path("/mnt/data/boxplot_0328_no_asterisks.ipynb")

with src.open("r", encoding="utf-8") as f:
    nb = json.load(f)

for cell in nb.get("cells", []):
    if cell.get("cell_type") == "code":
        source = "".join(cell.get("source", []))
        source = source.replace(
            "ax = sns.boxplot(x='Variable', y='Value', hue='Dataset', data=combined_df, palette=\"Set3\")",
            "ax = sns.boxplot(\n"
            "    x='Variable', y='Value', hue='Dataset', data=combined_df,\n"
            "    palette=\"Set3\", showfliers=False\n"
            ")"
        )
        cell["source"] = source.splitlines(keepends=True)
        # Remove stale outputs so the notebook displays only newly generated figures.
        cell["outputs"] = []
        cell["execution_count"] = None

with dst.open("w", encoding="utf-8") as f:
    json.dump(nb, f, ensure_ascii=False, indent=1)

print(f"Created: {dst}")
